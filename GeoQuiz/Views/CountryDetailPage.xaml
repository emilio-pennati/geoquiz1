<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GeoQuiz.ViewModels"
             x:Class="GeoQuiz.Views.CountryDetailPage"
             x:DataType="vm:CountryDetailViewModel"
             Title="{Binding Country.CommonName}">

    <Grid>
        <ScrollView IsVisible="{Binding HasData}" Margin="15">
            <VerticalStackLayout Spacing="15">
                <Frame CornerRadius="15" Padding="0" HorizontalOptions="Center">
                    <Image Source="{Binding Country.FlagUrl}"
                           HeightRequest="200"
                           Aspect="AspectFit"/>
                </Frame>

                <Label Text="{Binding Country.CommonName}"
                       FontSize="28"
                       FontAttributes="Bold"
                       HorizontalTextAlignment="Center"/>

                <Label Text="{Binding Country.OfficialName}"
                       FontSize="14"
                       TextColor="Gray"
                       HorizontalTextAlignment="Center"/>

                <HorizontalStackLayout HorizontalOptions="Center" Spacing="10" Margin="0,10,0,0">
                    <Label Text="{Binding Country.Region}"
                           FontSize="16"
                           TextColor="DarkBlue"/>
                    <Label Text=" - "
                           FontSize="16"
                           TextColor="Gray"/>
                    <Label Text="{Binding Country.Subregion}"
                           FontSize="16"
                           TextColor="DarkBlue"/>
                </HorizontalStackLayout>

                <Frame BackgroundColor="#F5F5F5" CornerRadius="10" Padding="15" Margin="0,15,0,0">
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="150,*">
                        <Label Text="Capital:" FontAttributes="Bold" Grid.Row="0" Grid.Column="0"/>
                        <Label Text="{Binding Country.CapitalCity}" Grid.Row="0" Grid.Column="1"/>

                        <Label Text="Continent:" FontAttributes="Bold" Grid.Row="1" Grid.Column="0" Margin="0,5,0,0"/>
                        <Label Text="{Binding Country.ContinentsList}" Grid.Row="1" Grid.Column="1" Margin="0,5,0,0"/>

                        <Label Text="Population:" FontAttributes="Bold" Grid.Row="2" Grid.Column="0" Margin="0,5,0,0"/>
                        <Label Text="{Binding Country.PopulationFormatted}" Grid.Row="2" Grid.Column="1" Margin="0,5,0,0"/>

                        <Label Text="Languages:" FontAttributes="Bold" Grid.Row="3" Grid.Column="0" Margin="0,5,0,0"/>
                        <Label Text="{Binding Country.LanguagesList}" Grid.Row="3" Grid.Column="1" Margin="0,5,0,0"/>

                        <Label Text="Currencies:" FontAttributes="Bold" Grid.Row="4" Grid.Column="0" Margin="0,5,0,0"/>
                        <Label Text="{Binding Country.CurrenciesList}" Grid.Row="4" Grid.Column="1" Margin="0,5,0,0"/>
                    </Grid>
                </Frame>
            </VerticalStackLayout>
        </ScrollView>

        <ActivityIndicator IsVisible="{Binding IsBusy}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           WidthRequest="50"
                           HeightRequest="50"/>

        <VerticalStackLayout IsVisible="{Binding HasError}"
                              HorizontalOptions="Center"
                              VerticalOptions="Center"
                              Margin="20">
            <Label Text="{Binding ErrorMessage}"
                   TextColor="Red"
                   FontSize="16"
                   HorizontalTextAlignment="Center"/>
        </VerticalStackLayout>
    </Grid>
</ContentPage>