<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:GeoQuiz"
             xmlns:converters="clr-namespace:GeoQuiz.Converters"
             x:Class="GeoQuiz.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
            <converters:StringToBoolConverter x:Key="StringToBoolConverter"/>
            <converters:ResultConverter x:Key="ResultConverter"/>
            <converters:ProgressConverter x:Key="ProgressConverter"/>
            <converters:TimerColorConverter x:Key="TimerColorConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
